# NVIDIA_API_KEY: Required for NVIDIA Nemotron 3 Ultra reasoning provider.
# Configure this via the Secrets panel in the AI Studio UI.
NVIDIA_API_KEY=

# GEMINI_API_KEY: Optional Gemini API key
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NVIDIA_NEMOTRON_API_KEY: Optional API key for NVIDIA Nemotron 3 Ultra reasoning provider.
NVIDIA_NEMOTRON_API_KEY=

